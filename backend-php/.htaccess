# Backend PHP — routing simple via Apache

AddDefaultCharset UTF-8

RewriteEngine On

# XAMPP / Apache : transmettre Authorization (Bearer JWT) à PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^meta/?$ meta.php [QSA,L]
RewriteRule ^contact/?$ contact.php [QSA,L]
RewriteRule ^partners/soutien$ partners.php?action=soutien [QSA,L]
RewriteRule ^partners/etablissement$ partners.php?action=etablissement [QSA,L]
RewriteRule ^partners/([a-f0-9-]+)/logo$ partners.php?action=logo&id=$1 [QSA,L]
RewriteRule ^partners/?$ partners.php?action=list [QSA,L]
RewriteRule ^faq/vote$ faq.php?action=vote [QSA,L]
RewriteRule ^faq/?$ faq.php [QSA,L]

RewriteRule ^auth/(register|login|me|forgot-password|reset-password|verify-reset)$ auth.php?action=$1 [QSA,L]
RewriteRule ^epreuves/?$ epreuves.php [QSA,L]
RewriteRule ^epreuves/([a-f0-9-]+)/preview$ epreuves-preview.php?id=$1 [QSA,L]
RewriteRule ^epreuves/([a-f0-9-]+)/download$ downloads.php?id=$1 [QSA,L]
RewriteRule ^epreuves/([a-f0-9-]+)$ epreuves.php?id=$1 [QSA,L]
RewriteRule ^soumissions/?$ soumissions.php [QSA,L]

RewriteRule ^paiements/initier$ payments.php?action=initier [QSA,L]
RewriteRule ^paiements/confirmer$ payments.php?action=confirmer [QSA,L]
RewriteRule ^paiements/acces/([a-f0-9-]+)$ payments.php?action=acces&epreuve_id=$1 [QSA,L]

RewriteRule ^account/favoris/list$ account.php?action=favoris_list [QSA,L]
RewriteRule ^account/favoris/([a-f0-9-]+)$ account.php?action=favoris_delete&epreuve_id=$1 [QSA,L]
RewriteRule ^account/favoris$ account.php?action=favoris [QSA,L]
RewriteRule ^account/library$ account.php?action=library [QSA,L]
RewriteRule ^account/downloads$ account.php?action=downloads [QSA,L]
RewriteRule ^account/soumissions/([a-f0-9-]+)/preview$ account.php?action=preview&id=$1 [QSA,L]
RewriteRule ^account/soumissions/([a-f0-9-]+)$ account.php?action=soumissions&id=$1 [QSA,L]
RewriteRule ^account/soumissions$ account.php?action=soumissions [QSA,L]
RewriteRule ^account/paiements$ account.php?action=paiements [QSA,L]
RewriteRule ^account/profile$ account.php?action=profile [QSA,L]
RewriteRule ^account/notifications/([a-f0-9-]+)/supprimer$ account.php?action=notifications_delete&id=$1 [QSA,L]
RewriteRule ^account/notifications/([a-f0-9-]+)$ account.php?action=notifications_delete&id=$1 [QSA,L]
RewriteRule ^account/notifications/read$ account.php?action=notifications_read [QSA,L]
RewriteRule ^account/notifications/subscribe$ account.php?action=notifications_subscribe [QSA,L]
RewriteRule ^account/notifications/unsubscribe$ account.php?action=notifications_unsubscribe [QSA,L]
RewriteRule ^account/notifications$ account.php?action=notifications [QSA,L]

RewriteRule ^wallet/portefeuille$ wallet.php?action=portefeuille [QSA,L]
RewriteRule ^wallet/retrait$ wallet.php?action=retrait [QSA,L]

RewriteRule ^admin/archives/file$ admin.php?action=archives_file [QSA,L]
RewriteRule ^admin/archives$ admin.php?action=archives [QSA,L]
RewriteRule ^admin/stats$ admin.php?action=stats [QSA,L]
RewriteRule ^admin/referentiels$ admin.php?action=referentiels [QSA,L]
RewriteRule ^admin/settings$ admin.php?action=settings [QSA,L]
RewriteRule ^admin/notifications/creer$ admin.php?action=creer_notification [QSA,L]
RewriteRule ^admin/notifications/([a-f0-9-]+)/modifier$ admin.php?action=modifier_notification&id=$1 [QSA,L]
RewriteRule ^admin/notifications/([a-f0-9-]+)/toggle$ admin.php?action=toggle_notification&id=$1 [QSA,L]
RewriteRule ^admin/notifications/([a-f0-9-]+)/supprimer$ admin.php?action=supprimer_notification&id=$1 [QSA,L]
RewriteRule ^admin/notifications/?$ admin.php?action=notifications [QSA,L]
RewriteRule ^admin/retraits/?$ admin.php?action=retraits [QSA,L]
RewriteRule ^admin/retraits/([a-f0-9-]+)/approuver$ admin.php?action=approuver_retrait&id=$1 [QSA,L]
RewriteRule ^admin/retraits/([a-f0-9-]+)/rejeter$ admin.php?action=rejeter_retrait&id=$1 [QSA,L]
RewriteRule ^admin/epreuves/([a-f0-9-]+)/corrige/supprimer$ admin.php?action=supprimer_corrige&id=$1 [QSA,L]
RewriteRule ^admin/epreuves/([a-f0-9-]+)/corrige$ admin.php?action=corrige&id=$1 [QSA,L]
RewriteRule ^admin/epreuves/?$ admin.php?action=epreuves [QSA,L]
RewriteRule ^admin/epreuves/([a-f0-9-]+)/archiver$ admin.php?action=archiver&id=$1 [QSA,L]
RewriteRule ^admin/epreuves/([a-f0-9-]+)/supprimer$ admin.php?action=supprimer&id=$1 [QSA,L]
RewriteRule ^admin/soumissions/?$ admin.php?action=list [QSA,L]
RewriteRule ^admin/soumissions/([a-f0-9-]+)/image/(.+)$ admin.php?action=soumission_image&id=$1&file=$2 [QSA,L]
RewriteRule ^admin/soumissions/([a-f0-9-]+)/preview$ admin.php?action=preview&id=$1 [QSA,L]
RewriteRule ^admin/soumissions/([a-f0-9-]+)/valider$ admin.php?action=valider&id=$1 [QSA,L]
RewriteRule ^admin/soumissions/([a-f0-9-]+)/rejeter$ admin.php?action=rejeter&id=$1 [QSA,L]
RewriteRule ^admin/soumissions/([a-f0-9-]+)/remplacer$ admin.php?action=remplacer&id=$1 [QSA,L]
RewriteRule ^admin/soumissions/([a-f0-9-]+)/archiver$ admin.php?action=archiver_soumission&id=$1 [QSA,L]
RewriteRule ^admin/users/creer$ admin.php?action=creer_user [QSA,L]
RewriteRule ^admin/users/([a-f0-9-]+)/stats$ admin.php?action=user_stats&id=$1 [QSA,L]
RewriteRule ^admin/users/([a-f0-9-]+)/modifier$ admin.php?action=modifier_user&id=$1 [QSA,L]
RewriteRule ^admin/users/([a-f0-9-]+)/reset-password$ admin.php?action=reset_user_password&id=$1 [QSA,L]
RewriteRule ^admin/users/([a-f0-9-]+)/supprimer$ admin.php?action=supprimer_user&id=$1 [QSA,L]
RewriteRule ^admin/users/([a-f0-9-]+)/role$ admin.php?action=role&id=$1 [QSA,L]
RewriteRule ^admin/users/([a-f0-9-]+)/?$ admin.php?action=user_detail&id=$1 [QSA,L]
RewriteRule ^admin/users/?$ admin.php?action=users [QSA,L]
RewriteRule ^admin/partenaires/?$ admin.php?action=partenaires [QSA,L]
RewriteRule ^admin/partenaires/creer$ admin.php?action=creer_partenaire [QSA,L]
RewriteRule ^admin/partenaires/([a-f0-9-]+)/modifier$ admin.php?action=modifier_partenaire&id=$1 [QSA,L]
RewriteRule ^admin/partenaires/([a-f0-9-]+)/supprimer$ admin.php?action=supprimer_partenaire&id=$1 [QSA,L]
RewriteRule ^admin/demandes-soutien/?$ admin.php?action=demandes_soutien [QSA,L]
RewriteRule ^admin/demandes-soutien/([a-f0-9-]+)/statut$ admin.php?action=statut_soutien&id=$1 [QSA,L]
RewriteRule ^admin/demandes-soutien/([a-f0-9-]+)/lu$ admin.php?action=lu_soutien&id=$1 [QSA,L]
RewriteRule ^admin/demandes-etablissement/?$ admin.php?action=demandes_etablissement [QSA,L]
RewriteRule ^admin/demandes-etablissement/([a-f0-9-]+)/statut$ admin.php?action=statut_etablissement&id=$1 [QSA,L]
RewriteRule ^admin/demandes-etablissement/([a-f0-9-]+)/lu$ admin.php?action=lu_etablissement&id=$1 [QSA,L]
