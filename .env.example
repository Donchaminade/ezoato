# URL de l'API PHP backend (obligatoire)
VITE_API_URL=http://localhost/zovu-project/backend-php

# --- Sécurité API (processus PHP, pas le bundle Vite) ---
# Production : EZOATO_ENV=production
#   - refuse le JWT placeholder CHANGE_ME_LONG_RANDOM_STRING
#   - refuse les comptes seed @tea.test
#   - refuse la confirmation client d'un paiement simulé
# Secret HMAC réel : clé jwt_secret de backend-php/config.local.php
# (les fonctions JWT lisent cette valeur, plus le fichier d'exemple).
# EZOATO_ENV=production
# EZOATO_ALLOW_INSECURE_JWT=0
# EZOATO_ALLOW_TEST_ACCOUNTS=0
# EZOATO_ALLOW_SIMULATED_PAYMENTS=0
# Secret du webhook simulé (header X-Ezoato-Webhook-Secret). Vide = webhook simulé refusé.
# EZOATO_PAYMENT_WEBHOOK_SECRET=

# Ezoato AI — clés côté serveur PHP uniquement (jamais VITE_*)
# EZOATO_AI_PROVIDER=auto|groq|google|openrouter|openai   (défaut auto ; mock = CI)
# Texte auto : Groq → Google (Gemini/Gemma) → OpenRouter (repli) → OpenAI → mock si EZOATO_AI_ALLOW_MOCK=1
# Vision/photo auto : Google multimodal → OpenRouter → OpenAI vision (Groq = texte seul)
# GROQ_API_KEY=
# EZOATO_AI_GROQ_MODEL=openai/gpt-oss-20b
#   (Llama 3.1/3.3 Groq = Enterprise : llama-3.3-70b-versatile / llama-3.1-8b-instant)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# EZOATO_AI_GOOGLE_MODEL=gemini-2.0-flash
#   (ou gemma-3-27b-it / gemma-4-26b-a4b-it — IDs Generative Language API)
# EZOATO_AI_GOOGLE_VISION_MODEL=gemini-2.0-flash
# OPENROUTER_API_KEY=
# EZOATO_AI_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
#   (VL gratuit listé OpenRouter sept. 2026 ; google/gemini-2.0-flash-exp:free n'est plus exposé)
#   Alternative routeur : openrouter/free
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Prod / dev déployé : EZOATO_AI_ALLOW_MOCK=0 (jamais de mock silencieux)
# CI / local sans clé uniquement :
# EZOATO_AI_ALLOW_MOCK=1
# EZOATO_AI_PROVIDER=mock

# --- Freemium (devoirs et compositions) ---
# Quota commun par défaut : 50 consultations ou téléchargements, puis Pro.
# EZOATO_FREEMIUM_QUOTA=50
# Pour des quotas séparés (50 devoirs ET 50 compositions) :
# EZOATO_FREEMIUM_QUOTA_MODE=separate
# EZOATO_FREEMIUM_QUOTA_DEVOIR=50
# EZOATO_FREEMIUM_QUOTA_COMPOSITION=50
# Mode shared (défaut) ignore les deux quotas séparés et n'utilise que EZOATO_FREEMIUM_QUOTA.

# --- Paiement Pro (1 000 FCFA / 6 mois, Flooz ou T-Money) ---
# EZOATO_PAYMENT_PROVIDER=auto
#   auto : PayGate si PAYGATE_AUTH_TOKEN, sinon FedaPay si FEDAPAY_SECRET_KEY, sinon simulé.
#   simulated : force la confirmation simulée même si une clé est présente.
#   paygate | fedapay : force l'adaptateur ; sans la clé correspondante, repli sur le simulé.
# Aucune clé ci-dessous ne doit être commitée. Tant qu'elles sont vides, dev ET prod restent simulés.
# PAYGATE_AUTH_TOKEN=
# PAYGATE_API_BASE=https://paygateglobal.com/api/v1
# FEDAPAY_SECRET_KEY=
# FEDAPAY_ENVIRONMENT=sandbox
# FEDAPAY_WEBHOOK_SECRET=
# FEDAPAY_API_BASE=
# URL publique appelée par l'opérateur (sinon {api_base_url}/webhooks/paiement) :
# EZOATO_PAYMENT_CALLBACK_URL=

# Notifications push navigateur (clé publique VAPID — même valeur que config.local.php)
# Générer : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
