# URL de l'API PHP backend (obligatoire)
VITE_API_URL=http://localhost/zovu-project/backend-php

# Ezoato AI — clés côté serveur PHP uniquement (jamais VITE_*)
# EZOATO_AI_PROVIDER=auto|groq|google|openai   (défaut auto ; mock = CI)
# Texte auto : Groq → Google (Gemini/Gemma) → OpenAI → mock si EZOATO_AI_ALLOW_MOCK=1
# Vision/photo auto : Google multimodal → OpenAI vision (Groq = texte seul)
# GROQ_API_KEY=
# EZOATO_AI_GROQ_MODEL=openai/gpt-oss-20b
#   (Llama 3.1/3.3 Groq = Enterprise : llama-3.3-70b-versatile / llama-3.1-8b-instant)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# EZOATO_AI_GOOGLE_MODEL=gemini-2.0-flash
#   (ou gemma-3-27b-it / gemma-4-26b-a4b-it — IDs Generative Language API)
# EZOATO_AI_GOOGLE_VISION_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Prod / dev déployé : EZOATO_AI_ALLOW_MOCK=0 (jamais de mock silencieux)
# CI / local sans clé uniquement :
# EZOATO_AI_ALLOW_MOCK=1
# EZOATO_AI_PROVIDER=mock

# Notifications push navigateur (clé publique VAPID — même valeur que config.local.php)
# Générer : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
