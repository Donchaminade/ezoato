# URL de l'API PHP backend (obligatoire)
VITE_API_URL=http://localhost/zovu-project/backend-php

# Ezoato AI — clés côté serveur PHP uniquement (jamais VITE_*)
# Primaire Gemini (GEMINI_API_KEY ou GOOGLE_API_KEY)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Repli optionnel
# OPENAI_API_KEY=sk-...
# EZOATO_AI_ALLOW_MOCK=1
# EZOATO_AI_PROVIDER=mock

# Notifications push navigateur (clé publique VAPID — même valeur que config.local.php)
# Générer : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
