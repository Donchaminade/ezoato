# Référence uniquement — Flutter ne lit pas ce fichier sans plugin.
# Passez les valeurs via --dart-define (voir MOBILE.md).

# Émulateur Android (recommandé)
# flutter run --dart-define=USE_EMULATOR_HOST=true
# ou --dart-define=API_URL=http://10.0.2.2/zovu-project/backend-php

# Simulateur iOS / Windows desktop
# flutter run --dart-define=API_URL=http://localhost/zovu-project/backend-php

# Appareil physique (ipconfig → IPv4 Wi-Fi)
# flutter run --dart-define=DEV_LAN_HOST=10.14.202.205
# ou --dart-define=API_URL=http://10.14.202.205/zovu-project/backend-php

# Frontend web (contact, liens e-mail reset password)
# flutter run --dart-define=WEB_URL=http://localhost:5173
# Prod : --dart-define=WEB_URL=https://ezoa-to.tg
